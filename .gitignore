# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# SECRETS -- identity files contain Ed25519 and X25519 PRIVATE KEYS.
# Never commit these; a leaked identity is full impersonation until the
# roster is updated (see docs/THREAT-MODEL.md).
#
# `--identity` takes any path, so no pattern can cover every name someone
# might choose. The docs therefore all use the `*-identity.json` form these
# rules do catch, and `keygen` warns when it writes somewhere they do not.
identity.json
*identity.json
*-identity.json
*.pem
*.key
*.crt
.env

# Local state
roster.json
*.db

# Model weights and engine binaries. docs/ENGINE-NOTES.md tells a contributor to
# download these; a stray `git add -A` afterwards would otherwise commit gigabytes.
*.gguf
llama-b*/
*.tgz

# Scratch
demo/
*.log
# Working notes kept locally; not part of the published tree.
docs/HANDOFF.md
